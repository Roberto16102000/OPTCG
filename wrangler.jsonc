{
  // Publicación en Cloudflare Workers con archivos estáticos.
  //
  // Aquí viven las cartas en grande: 5.775 imágenes de 900 px que pesan unos
  // 555 MB. No caben en Vercel -250 MB por despliegue- pero sí aquí, donde
  // las peticiones a archivos estáticos son gratis e ilimitadas y guardarlos
  // no cuesta. Los límites que sí aplican son 20.000 archivos por versión
  // -vamos por 11.638- y 25 MiB por archivo, que ninguna se acerca.
  //
  // `single-page-application` es imprescindible: expo-router resuelve las
  // rutas en el navegador, así que entrar directo a /packs o /binder tiene que
  // devolver el index.html en vez de un 404.
  //
  // El comando de construcción es `npm run build:pwa`, que aparta los 1,7 GB
  // de originales antes de exportar y los devuelve al terminar.
  "name": "optcg",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
